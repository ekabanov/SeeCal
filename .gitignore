# macOS
.DS_Store

# Python
ml/.venv*/
__pycache__/
*.pyc
.cache/

# Swift / Xcode
.swiftpm-home/
ios/SeeCal/.build/
# Legacy app dir removed from git; only a local weights cache remains on disk
ios/SeeCalApp/

# App wrapper — generated by xcodegen (scripts/build.sh) + build products
ios/App/SeeCal.xcodeproj/
ios/App/Info.plist
ios/App/SeeCal.entitlements
ios/App/build/

# Release credentials (scripts/release-setup.sh) — never commit
.secrets/

# Raw + derived datasets (regenerable via select_images.py/prepare_finetune.py)
ml/Nutrition5K/
ml/dataset_clean/
ml/dataset_clean_sample/
ml/finetune_data_sample/
# v7 not-food negatives: COCO annotations cache + sampled negative images
# (regenerable via download_negatives.sh; never redistributed — like Nutrition5K).
ml/coco/
ml/negatives/
# Visual-specialist public datasets, extracted images, and legal snapshots.
# Committed source configs/manifests live under ml/teacher_labeling instead.
ml/datasets/
# v7 combined training data (food + negatives) — regenerable via make_v7_data.py,
# references the gitignored negatives images.
ml/finetune_data_v7*/
ml/finetune_data_v8*/
ml/finetune_data_id*/

# Training outputs / model weights
*.safetensors
ml/adapters*/
ml/fused*/
ml/runs/
ml/*.log

# Session scratch
.superpowers/
