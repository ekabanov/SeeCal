+def _extract_images_from_content(conversations):
+    """Extract image file paths embedded in message content arrays.
+
+    When JSONL records store images as {"type": "image", "image": path}
+    inside message content arrays (Qwen3.5 native format), this helper
+    collects those paths so the vision encoder can actually process them.
+    Returns a list of loaded PIL Images.
+    """
+    loaded = []
+    if not isinstance(conversations, list):
+        return loaded
+    for msg in conversations:
+        if not isinstance(msg, dict):
+            continue
+        content = msg.get("content", [])
+        if not isinstance(content, list):
+            continue
+        for entry in content:
+            if isinstance(entry, dict) and entry.get("type") == "image":
+                path = entry.get("image")
+                if path:
+                    try:
+                        loaded.append(Image.open(path).convert("RGB"))
+                    except Exception as e:
+                        warnings.warn(f"Could not load embedded image '{path}': {e}")
+    return loaded
+
+
+def _normalize_conversation(conversation):
+    """Remove None-valued keys that PyArrow adds when normalizing the JSONL schema.
+
+    When HuggingFace datasets loads JSONL with mixed-key content dicts (e.g., some
+    entries have an "image" key, others only have "text"), PyArrow fills in None for
+    every key that is missing in any row so the columnar schema stays uniform.
+
+    This causes the Qwen3VL Jinja2 chat template to misidentify text content entries
+    as image entries, because it checks ``'image' in item`` (key presence, not value)
+    and that check returns True even when the value is None:
+
+      {"type": "text", "image": None, "text": "..."} → treated as an image
+        → extra <|image_pad|> token → image_grid_thw IndexError during training
+
+    Stripping None-valued keys restores the original semantics so the template only
+    inserts one <|image_pad|> per actual image.
+    """
+    if not isinstance(conversation, list):
+        return conversation
+    result = []
+    for msg in conversation:
+        if not isinstance(msg, dict):
+            result.append(msg)
+            continue
+        content = msg.get("content", [])
+        if isinstance(content, list):
+            new_content = []
+            for entry in content:
+                if isinstance(entry, dict):
+                    entry = {k: v for k, v in entry.items() if v is not None}
+                new_content.append(entry)
+            msg = {**msg, "content": new_content}
+        result.append(msg)
+    return result
 
 
